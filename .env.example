# Copier ce fichier en .env (jamais commité). Rien n'est obligatoire pour la version locale.
# Adresse e-mail transmise poliment à OpenAlex (bonnes pratiques de l'API)
TRANSFIA_CONTACT_EMAIL=
# Fichier de configuration à utiliser (par défaut : config/local.yaml)
TRANSFIA_CONFIG=config/local.yaml
# Clés cloud (chapitres 12 à 14 du dossier) — seulement si tu testes le cloud
GEMINI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
# Une fois les modèles téléchargés : plus aucun appel réseau à Hugging Face (plus rapide, plus d'avertissement)
HF_HUB_OFFLINE=1
